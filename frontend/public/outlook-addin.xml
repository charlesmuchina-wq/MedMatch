<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <Id>lumi-ai-hub-1</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>MedMatch</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AI KARAU Meeting Scheduler" />
  <Description DefaultValue="Schedule AI-powered video meetings with AI KARAU directly from Outlook. Features include AI transcription, breakout rooms, and meeting analytics." />
  <IconUrl DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/icons/icon-192x192.png" />
  <HighResolutionIconUrl DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/icons/icon-512x512.png" />
  <SupportUrl DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/support" />

  <AppDomains>
    <AppDomain>https://medmatch-jobs-dev.preview.emergentagent.com</AppDomain>
    <AppDomain>https://aikarau.com</AppDomain>
    <AppDomain>https://enzilink.com</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/outlook/read" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/outlook/compose" />
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit" />
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
  </Rule>

  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="functionFile" />

          <!-- Appointment Organizer (Compose) -->
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="karauMeetingGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="scheduleKarauBtn">
                  <Label resid="scheduleBtnLabel" />
                  <Supertip>
                    <Title resid="scheduleBtnLabel" />
                    <Description resid="scheduleBtnDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="scheduleTaskpane" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Appointment Attendee (Read) -->
          <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="karauJoinGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="joinKarauBtn">
                  <Label resid="joinBtnLabel" />
                  <Supertip>
                    <Title resid="joinBtnLabel" />
                    <Description resid="joinBtnDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="joinTaskpane" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Message Read -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="karauMessageGroup">
                <Label resid="groupLabel" />
                <Control xsi:type="Button" id="createMeetingFromMsgBtn">
                  <Label resid="createFromMsgLabel" />
                  <Supertip>
                    <Title resid="createFromMsgLabel" />
                    <Description resid="createFromMsgDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="icon16" />
                    <bt:Image size="32" resid="icon32" />
                    <bt:Image size="80" resid="icon80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="createFromMsgTaskpane" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="icon16" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/icons/icon-72x72.png" />
        <bt:Image id="icon32" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/icons/icon-96x96.png" />
        <bt:Image id="icon80" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/icons/icon-128x128.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="functionFile" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/outlook/functions.html" />
        <bt:Url id="scheduleTaskpane" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/outlook/schedule?outlook=true" />
        <bt:Url id="joinTaskpane" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/outlook/join?outlook=true" />
        <bt:Url id="createFromMsgTaskpane" DefaultValue="https://medmatch-jobs-dev.preview.emergentagent.com/outlook/create-from-message?outlook=true" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="groupLabel" DefaultValue="AI KARAU" />
        <bt:String id="scheduleBtnLabel" DefaultValue="Add AI KARAU Meeting" />
        <bt:String id="joinBtnLabel" DefaultValue="Join AI KARAU Meeting" />
        <bt:String id="createFromMsgLabel" DefaultValue="Create KARAU Meeting" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="scheduleBtnDesc" DefaultValue="Schedule an AI-powered video meeting with transcription, breakout rooms, and analytics." />
        <bt:String id="joinBtnDesc" DefaultValue="Join the AI KARAU meeting associated with this event." />
        <bt:String id="createFromMsgDesc" DefaultValue="Create a new AI KARAU meeting from this email conversation." />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>
