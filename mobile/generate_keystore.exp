#!/usr/bin/expect -f

set timeout 120
set env(EXPO_TOKEN) "T5ZSsYKhdeURiXWX3ZumKYe1yuTlKGnGPYSpOUd8"

spawn eas credentials:configure-build -p android -e preview

expect {
    "Generate a new Android Keystore?" {
        send "Y\r"
        exp_continue
    }
    "Would you like to set it" {
        send "Y\r"
        exp_continue
    }
    eof
}

puts "\nKeystore generation complete!"
