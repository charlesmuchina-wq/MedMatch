#!/usr/bin/expect -f

set timeout 600
set env(EXPO_TOKEN) "T5ZSsYKhdeURiXWX3ZumKYe1yuTlKGnGPYSpOUd8"
set env(EXPO_APPLE_ID) "cmuchina@hotmail.com"

log_user 1

spawn eas credentials -p ios

expect {
    -re "Which build profile" {
        send "1\r"
        exp_continue
    }
    -re "What do you want to do" {
        send "1\r"
        exp_continue
    }
    -re "Apple ID:" {
        send "cmuchina@hotmail.com\r"
        exp_continue
    }
    -re "assword" {
        send "ylby-vmcy-rnkn-bsbt\r"
        exp_continue
    }
    -re "elect a Team" {
        send "1\r"
        exp_continue
    }
    -re "Generate a new Apple Distribution Certificate" {
        send "Y\r"
        exp_continue
    }
    -re "Generate a new Apple Provisioning Profile" {
        send "Y\r"
        exp_continue
    }
    -re "Set up Push Notifications" {
        send "n\r"
        exp_continue
    }
    -re "Use an existing Push Key" {
        send "n\r"
        exp_continue
    }
    -re "Would you like" {
        send "Y\r"
        exp_continue
    }
    -re "Create a new" {
        send "Y\r"
        exp_continue
    }
    timeout {
        puts "\n\n=== TIMEOUT - Check Expo Dashboard ==="
        exit 0
    }
    eof {
        puts "\n\n=== iOS credential setup finished ==="
    }
}
