#!/usr/bin/expect -f

set timeout 300
set env(EXPO_TOKEN) "T5ZSsYKhdeURiXWX3ZumKYe1yuTlKGnGPYSpOUd8"

spawn eas credentials:configure-build -p ios -e preview

expect {
    -re "Apple ID:" {
        send "cmuchina@hotmail.com\r"
        exp_continue
    }
    -re "password" {
        send_user "\n\nApple password required - skipping iOS credential setup\n"
        exit 1
    }
    -re "Select Team" {
        send "1\r"
        exp_continue
    }
    -re "Would you like" {
        send "Y\r"
        exp_continue
    }
    -re "Generate a new" {
        send "Y\r"
        exp_continue
    }
    eof
}

puts "\niOS credential setup complete!"
