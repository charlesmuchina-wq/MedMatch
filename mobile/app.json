{
  "expo": {
    "name": "MedMatch AI Job Search",
    "slug": "medmatch-ai-job-search-aid",
    "owner": "cmuchina",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "medmatch",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medmatch.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MedMatch needs camera access for ID verification and video interviews",
        "NSMicrophoneUsageDescription": "MedMatch needs microphone access for voice coaching and interviews",
        "NSPhotoLibraryUsageDescription": "MedMatch needs photo access to upload your resume documents"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.medmatch.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MedMatch to access your camera for ID verification and video interviews"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow MedMatch to access your microphone for voice coaching"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4f46e5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "be604cc0-241c-44b4-b2d2-77d933214c9d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be604cc0-241c-44b4-b2d2-77d933214c9d"
    }
  }
}
